---
interface Props {
  title: string;
  description: string;
}
import MotionHero from '../components/MotionHero.astro';
import MotionLogo from '../components/MotionLogo.astro';
import MotionSettings from '../components/MotionSettings.astro';
import { progress } from '../data/project';
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const links = ['install', 'applications', 'runtimes', 'security', 'status'];
---

<!doctype html>
<html lang="en" data-motion-enabled="true" data-motion-logo="L7" data-motion-hero="H6" data-motion-effects="F2 F7" data-motion-paused="false" data-motion-debug="false">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0e" />
    <link rel="alternate" type="application/rss+xml" title="Shared Pair application feed" href="/feed.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Shared Pair home">
        <MotionLogo />
        <span>SHARED PAIR</span>
        <small>2c–2e</small>
      </a>
      <nav aria-label="Primary">
        {links.map((link) => <a href={`/${link}/`} aria-current={path.startsWith(`/${link}/`) ? 'page' : undefined}>{link}</a>)}
      </nav>
      <div class="top-actions"><a class="source" href="/about/">About →</a><button class="motion-control" type="button" data-motion-open aria-haspopup="dialog"><span aria-hidden="true">◉</span> Motion</button></div>
    </header>
    <main id="content"><MotionHero /><slot /></main>
    <footer>
      <div>
        <a class="brand footer-brand" href="/"><MotionLogo /><span>SHARED PAIR</span></a>
        <p>Shared Electron runtimes for Linux.</p>
        <MotionSettings />
      </div>
      <div class="footer-links"><a href="/about/">About</a><a href="/runtimes/">Runtimes</a><a href="/security/">Security</a><a href="/status/">Status</a></div>
      <div class="footer-tail"><a class="activity-ticker" href="/feed.xml"><span>{progress[0].state}</span>{progress[0].entry}</a><p class="legal">Packages are built and tested; APT publication is pending approval. Independent of Electron, OpenJS, Debian, and Ubuntu.</p></div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0a0b0e;
    --surface: #111319;
    --surface-2: #171a21;
    --ink: #eef1e7;
    --muted: #9da397;
    --faint: #656b64;
    --lime: #b9ff66;
    --violet: #a58bff;
    --line: rgba(238,241,231,.13);
    --line-strong: rgba(238,241,231,.24);
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: "IBM Plex Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; color: var(--ink); background:
    radial-gradient(circle at 72% 8%, rgba(165,139,255,.09), transparent 28rem),
    radial-gradient(circle at 30% 18%, rgba(185,255,102,.06), transparent 32rem), var(--bg); font: 17px/1.6 var(--sans); }
  body::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .22; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; }
  a { color: inherit; }
  .skip { position: fixed; z-index: 100; left: 1rem; top: -5rem; padding: .7rem 1rem; background: var(--lime); color: #090b08; }
  .skip:focus { top: 1rem; }
  :focus-visible { outline: 2px solid var(--lime); outline-offset: 4px; }
  .topbar { position: sticky; top: 0; z-index: 30; min-height: 72px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(1.2rem, 4vw, 4rem); border-bottom: 1px solid var(--line); background: rgba(10,11,14,.82); backdrop-filter: blur(18px); }
  .brand { display: inline-flex; align-items: center; gap: .68rem; text-decoration: none; font: 700 .76rem/1 var(--mono); letter-spacing: .13em; }
  .brand small { color: var(--faint); font-weight: 400; }
  nav { display: flex; gap: clamp(.8rem, 2vw, 1.7rem); }
  nav a, .source, .footer-links a { color: var(--muted); text-decoration: none; font: .68rem/1 var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  nav a:hover, nav a[aria-current='page'], .source:hover, .footer-links a:hover { color: var(--ink); }
  .top-actions { justify-self: end; display: flex; align-items: center; gap: 1rem; }
  .motion-control { display: inline-flex; align-items: center; gap: .4rem; min-height: 34px; padding: 0 .65rem; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); cursor: pointer; font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .motion-control span { color: var(--lime); animation: motion-control-pulse 2s ease-in-out infinite; }
  .motion-control:hover { border-color: var(--lime); }
  @keyframes motion-control-pulse { 50% { color: var(--violet); transform: scale(.8); } }
  main { position: relative; z-index: 1; }
  .shell { width: min(1180px, calc(100% - 2.4rem)); margin-inline: auto; }
  .eyebrow { margin: 0 0 1rem; color: var(--lime); font: .69rem/1.4 var(--mono); letter-spacing: .16em; text-transform: uppercase; }
  .eyebrow::before { content: '///'; margin-right: .7rem; color: var(--faint); }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { letter-spacing: -.045em; line-height: .94; }
  h1 { font-size: clamp(2.7rem, 5vw, 5rem); }
  h2 { font-size: clamp(1.9rem, 3.5vw, 3.5rem); }
  h3 { font-size: 1.1rem; }
  .lede { max-width: 720px; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .button { display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.15rem; border: 1px solid var(--line-strong); text-decoration: none; font: .72rem var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  .button.primary { border-color: var(--lime); background: var(--lime); color: #10130d; font-weight: 700; }
  .button:hover { transform: translateY(-1px); box-shadow: 0 8px 30px rgba(185,255,102,.1); }
  .tag { display: inline-flex; align-items: center; gap: .45rem; color: var(--muted); font: .66rem var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  .tag::before { content: ''; width: 6px; height: 6px; background: var(--violet); border-radius: 50%; }
  footer { width: min(1180px, calc(100% - 2.4rem)); margin: 4rem auto 0; padding: 2rem 0 3rem; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; align-items: start; }
  footer p { margin: .8rem 0 0; color: var(--faint); font-size: .82rem; }
  .footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 2rem; }
  .legal { justify-self: end; max-width: 340px; text-align: right; }
  .footer-tail { justify-self: end; max-width: 360px; }
  .activity-ticker { display: none; padding: .7rem; border: 1px solid var(--line); color: var(--muted); text-decoration: none; font-size: .78rem; }
  .activity-ticker span { display: block; margin-bottom: .25rem; color: var(--violet); font: .6rem var(--mono); text-transform: uppercase; }
  html[data-motion-enabled='true'][data-motion-effects~='F1'] nav a[aria-current='page']::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: .45rem; border-radius: 50%; background: var(--lime); animation: nav-electron 1.8s ease-in-out infinite; }
  html[data-motion-enabled='true'][data-motion-effects~='F2'] nav a { position: relative; }
  html[data-motion-enabled='true'][data-motion-effects~='F2'] nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: -.7rem; height: 1px; background: linear-gradient(90deg,var(--lime),var(--violet)); animation: bond-in .7s ease-out both; }
  html[data-motion-enabled='true'][data-motion-effects~='F3'] .footer-brand :is(.logo-loop,.logo-electron) { animation-direction: reverse !important; }
  html[data-motion-enabled='true'][data-motion-effects~='F4'] .topbar::after { content: '42 TESTED  ·  44 TESTED'; position: absolute; right: 1rem; bottom: 3px; color: var(--faint); font: .52rem var(--mono); }
  html[data-motion-enabled='true'][data-motion-effects~='F5'] .topbar::before { content: ''; position: absolute; left: 0; bottom: 0; width: calc(var(--reading-progress, 0) * 100%); height: 2px; background: linear-gradient(90deg,var(--lime),var(--violet)); }
  html[data-motion-enabled='true'][data-motion-effects~='F6'] footer::before { content: ''; position: absolute; left: 15%; right: 15%; top: -1px; height: 2px; background: linear-gradient(90deg,transparent,var(--lime),var(--violet),transparent); animation: recombine 3s ease-in-out infinite; }
  html[data-motion-enabled='true'][data-motion-effects~='F7'] .activity-ticker { display: block; animation: ticker-in .6s ease-out both; }
  html[data-motion-enabled='true'][data-motion-effects~='F8'] :is(nav,.footer-links) a { transition: transform .2s ease, color .2s ease; }
  html[data-motion-enabled='true'][data-motion-effects~='F8'] :is(nav,.footer-links) a:hover { transform: translateY(-3px) scale(1.04); }
  html[data-motion-enabled='true'][data-motion-effects~='F9'] .activity-ticker span::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: .4rem; border-radius: 50%; background: var(--lime); animation: heartbeat 1.5s ease-in-out infinite; }
  html[data-motion-enabled='true'][data-motion-effects~='F10'] { view-transition-name: sharedpair-page; }
  footer { position: relative; }
  @keyframes nav-electron { 50% { transform: translateY(-4px); box-shadow: 0 0 8px var(--lime); } }
  @keyframes bond-in { from { transform: scaleX(0); } }
  @keyframes recombine { 50% { left: 45%; right: 45%; filter: drop-shadow(0 0 8px var(--lime)); } }
  @keyframes ticker-in { from { opacity: 0; transform: translateY(8px); } }
  @keyframes heartbeat { 50% { opacity: .35; transform: scale(.7); } }
  @view-transition { navigation: auto; }
  ::view-transition-old(sharedpair-page), ::view-transition-new(sharedpair-page) { animation-duration: .35s; }
  /* The site is documentation first: keep display type and section rhythm subordinate to the content. */
  main h1 { font-size: clamp(2.7rem, 5vw, 5rem) !important; }
  main h2 { font-size: clamp(1.9rem, 3.5vw, 3.5rem) !important; }
  main .page-hero, main .report-hero { min-height: auto !important; padding-block: clamp(2.25rem, 5vw, 3.75rem) !important; }
  main .hero { min-height: auto !important; padding-block: clamp(3rem, 7vw, 5rem) !important; }
  main .section { padding-block: clamp(3rem, 6vw, 5.5rem) !important; }
  main .records, main .runtime, main .status-section { padding-block: 2rem !important; }
  @media (max-width: 880px) {
    .topbar { grid-template-columns: 1fr auto; padding-top: .9rem; }
    .topbar nav { grid-column: 1 / -1; width: 100%; overflow-x: auto; gap: 1.25rem; padding: .85rem 0; scrollbar-width: none; }
    .topbar nav::-webkit-scrollbar { display: none; }
    .topbar nav a { flex: 0 0 auto; }
    .topbar .top-actions { grid-column: 2; grid-row: 1; }
    footer { grid-template-columns: 1fr; }
    .legal, .footer-tail { justify-self: start; text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
</style>
