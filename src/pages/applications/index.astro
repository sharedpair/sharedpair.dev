---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BondMark from '../../components/BondMark.astro';
import { applications, blockedApplications, runtimes } from '../../data/project';
import candidateData from '../../data/application-candidates.json';

const runtimeGroups = runtimes.map((runtime) => ({ version: runtime.version, packageName: runtime.packageName, apps: applications.filter((app) => app.runtime === runtime.packageName) }));
const catalogSize = applications.length + blockedApplications.length;
const candidates = candidateData.candidates.filter((candidate) => candidate.audit?.state === 'viable');
const candidateCategories = [...new Set(candidates.map((candidate) => candidate.category))].sort();
const candidateGroups = candidateCategories.map((category) => ({
  category,
  candidates: candidates.filter((candidate) => candidate.category === category).sort((a, b) => (b.github?.stars ?? -1) - (a.github?.stars ?? -1) || a.name.localeCompare(b.name)),
}));
const repositoryLabel = (candidate: (typeof candidates)[number]) => candidate.github?.url ? new URL(candidate.github.url).pathname.slice(1) : 'Source';
---

<BaseLayout title="Applications — Shared Pair" description="Application packages and their technical reports for Shared Pair runtimes.">
  <header class="page-hero shell">
    <div><p class="eyebrow">Applications</p><h1>{applications.length} apps.<br />{runtimes.length} runtimes.</h1><p class="lede">Each application owns its packaging, compatibility, provenance, and test report. Results describe the package that was actually built and tested.</p></div>
    <BondMark compact />
  </header>
  <section class="filters shell" aria-labelledby="filter-heading">
    <div class="filter-heading"><div><p class="eyebrow">Find an application</p><h2 id="filter-heading">Filter the catalog</h2></div><p id="result-count" aria-live="polite">Showing all {catalogSize} applications</p></div>
    <form id="catalog-filters" action="/applications/" method="get">
      <label class="search"><span>Search by name or purpose</span><input type="search" name="q" autocomplete="off" /></label>
      <label><span>Category</span><select name="category"><option value="">All categories</option><option value="communication">Communication</option><option value="data-science">Data science</option><option value="media">Media</option><option value="productivity">Productivity</option></select></label>
      <label><span>Runtime version</span><select name="runtime"><option value="">All runtimes</option>{runtimes.map((runtime) => <option value={runtime.packageName}>Electron {runtime.major}</option>)}</select></label>
      <label><span>Publication status</span><select name="status"><option value="">Any status</option><option value="tested">Tested</option><option value="blocked">Blocked</option></select></label>
      <label><span>Release channel</span><select name="channel"><option value="">Any channel</option><option value="stable">Stable</option><option value="prerelease">Prerelease</option><option value="candidate">Candidate snapshot</option></select></label>
      <button type="button" id="reset-filters">Reset</button>
    </form>
  </section>
  {runtimeGroups.map((group) => <section class="records shell catalog-group" data-catalog-group>
    <header class="runtime-heading"><div><p class="eyebrow">Shared runtime</p><h2>Electron <em>{group.version}</em></h2></div><div><strong>{group.packageName}</strong><small>{group.apps.length} {group.apps.length === 1 ? 'application' : 'applications'} tested</small></div></header>
    {group.apps.map((app, index) => <a class={`record ${(app.interfaceScreenshot || app.screenshot) ? 'has-image' : ''}`} href={`/applications/${app.slug}/`} data-catalog-record data-name={`${app.name} ${app.purpose}`.toLowerCase()} data-category={app.category} data-runtime={app.runtime} data-status={app.state} data-channel={app.releaseChannel}><span>{String(index + 1).padStart(2, '0')}</span>{(app.interfaceScreenshot || app.screenshot) && <img src={(app.interfaceScreenshot || app.screenshot)!.src} alt="" loading="lazy" />}<div><h3>{app.name}</h3><p>{app.purpose}. {app.test}</p></div><small><b>Electron {app.electron}</b><br />{app.version}</small><b>→</b></a>)}
  </section>)}
  <section class="records shell blocked catalog-group" data-catalog-group>
    <p class="eyebrow">Publication blocked</p>
    {blockedApplications.map((app) => <a class={`record ${app.interfaceScreenshot ? 'has-image' : ''}`} href={`/applications/${app.slug}/`} data-catalog-record data-name={`${app.name} ${app.purpose}`.toLowerCase()} data-category={app.category} data-runtime={app.runtime} data-status={app.state} data-channel={app.releaseChannel}><span>01</span>{app.interfaceScreenshot && <img src={app.interfaceScreenshot.src} alt="" loading="lazy" />}<div><h3>{app.name}</h3><p>{app.proof}</p></div><small><b>Electron {app.electron}</b><br />Review required</small><b>→</b></a>)}
  </section>
  <section class="candidates shell" aria-labelledby="candidate-heading">
    <header class="candidate-heading"><div><p class="eyebrow">Under consideration</p><h2 id="candidate-heading">What should we package next?</h2></div><p>{candidates.length} source-listed Electron applications survived the first viability cut. Inclusion here is not a promise: Linux support, maintenance, licensing, runtime compatibility, and testability still need review.</p></header>
    <div class="candidate-controls">
      <label><span>Search candidates by name or purpose</span><input id="candidate-search" type="search" autocomplete="off" /></label>
      <label><span>Category</span><select id="candidate-category"><option value="">All categories</option>{candidateCategories.map((category) => <option value={category}>{category}</option>)}</select></label>
      <p id="candidate-count" aria-live="polite">Showing all {candidates.length} candidates</p>
    </div>
    <p class="voting-note">Votes help order investigations; they do not override licensing, security, or compatibility review. No account is required. Repeat-vote prevention is intentionally lightweight and stored only in this browser.</p>
    <div class="candidate-groups" id="candidate-grid">
      {candidateGroups.map((group) => <section data-candidate-group><h3>{group.category}</h3><div class="candidate-table-wrap"><table><thead><tr><th>Project</th><th>Repository</th><th>Stars</th><th>Forks</th><th>Releases</th><th>Electron</th><th>Priority</th></tr></thead><tbody>
        {group.candidates.map((candidate) => <tr data-candidate data-name={`${candidate.name} ${candidate.description}`.toLowerCase()} data-category={candidate.category}>
          <td><strong>{candidate.name}</strong><small>{candidate.description}</small></td>
          <td><a href={candidate.github?.url ?? candidate.repository} rel="noreferrer">{repositoryLabel(candidate)} ↗</a></td>
          <td>{candidate.github?.stars?.toLocaleString() ?? '—'}</td><td>{candidate.github?.forks?.toLocaleString() ?? '—'}</td><td>{candidate.github?.releases?.toLocaleString() ?? '—'}</td><td>{candidate.audit?.electronDeclaration ?? '—'}</td>
          <td><button type="button" data-vote={candidate.slug} aria-label={`Vote for ${candidate.name}`}><span>Vote</span><b data-vote-count>0</b></button></td>
        </tr>)}
      </tbody></table></div></section>)}
    </div>
    <p class="candidate-empty" id="candidate-empty" hidden>No candidates match that search.</p>
    <p class="vote-status" id="vote-status" aria-live="polite"></p>
  </section>
  <section class="empty shell" id="empty-results" hidden><p class="eyebrow">No matches</p><h2>No applications match those filters.</h2><button type="button" data-reset-filters>Clear filters</button></section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#catalog-filters');
  const records = [...document.querySelectorAll<HTMLElement>('[data-catalog-record]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-catalog-group]')];
  const count = document.querySelector<HTMLElement>('#result-count');
  const empty = document.querySelector<HTMLElement>('#empty-results');

  function restoreFilters() {
    if (!form) return;
    const params = new URLSearchParams(window.location.search);
    for (const element of form.elements) {
      if (element instanceof HTMLInputElement || element instanceof HTMLSelectElement) element.value = params.get(element.name) ?? '';
    }
  }

  function applyFilters() {
    if (!form || !count || !empty) return;
    const data = new FormData(form);
    const query = String(data.get('q') ?? '').trim().toLowerCase();
    const facets = ['category', 'runtime', 'status', 'channel'] as const;
    let visible = 0;

    for (const record of records) {
      const matchesQuery = !query || (record.dataset.name ?? '').includes(query);
      const matchesFacets = facets.every((facet) => !data.get(facet) || record.dataset[facet] === data.get(facet));
      record.hidden = !(matchesQuery && matchesFacets);
      if (!record.hidden) visible += 1;
    }

    for (const group of groups) group.hidden = !group.querySelector('[data-catalog-record]:not([hidden])');
    empty.hidden = visible !== 0;
    count.textContent = visible === records.length ? `Showing all ${visible} applications` : `Showing ${visible} of ${records.length} applications`;

    const params = new URLSearchParams();
    for (const [key, value] of data.entries()) if (value) params.set(key, String(value));
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
  }

  function resetFilters() {
    form?.reset();
    applyFilters();
    form?.querySelector<HTMLInputElement>('input')?.focus();
  }

  restoreFilters();
  applyFilters();
  form?.addEventListener('input', applyFilters);
  form?.addEventListener('submit', (event) => event.preventDefault());
  document.querySelector('#reset-filters')?.addEventListener('click', resetFilters);
  document.querySelector('[data-reset-filters]')?.addEventListener('click', resetFilters);
  window.addEventListener('popstate', () => { restoreFilters(); applyFilters(); });

  const candidateSearch = document.querySelector<HTMLInputElement>('#candidate-search');
  const candidateCategory = document.querySelector<HTMLSelectElement>('#candidate-category');
  const candidateRecords = [...document.querySelectorAll<HTMLElement>('[data-candidate]')];
  const candidateGroups = [...document.querySelectorAll<HTMLElement>('[data-candidate-group]')];
  const candidateCount = document.querySelector<HTMLElement>('#candidate-count');
  const candidateEmpty = document.querySelector<HTMLElement>('#candidate-empty');
  const voteStatus = document.querySelector<HTMLElement>('#vote-status');
  const voteButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-vote]')];
  const voted = new Set<string>(JSON.parse(localStorage.getItem('sharedpair-votes') ?? '[]'));

  function filterCandidates() {
    const query = candidateSearch?.value.trim().toLowerCase() ?? '';
    const category = candidateCategory?.value ?? '';
    let visible = 0;
    for (const record of candidateRecords) {
      record.hidden = Boolean((query && !(record.dataset.name ?? '').includes(query)) || (category && record.dataset.category !== category));
      if (!record.hidden) visible++;
    }
    for (const group of candidateGroups) group.hidden = !group.querySelector('[data-candidate]:not([hidden])');
    if (candidateCount) candidateCount.textContent = visible === candidateRecords.length ? `Showing all ${visible} candidates` : `Showing ${visible} of ${candidateRecords.length} candidates`;
    if (candidateEmpty) candidateEmpty.hidden = visible !== 0;
  }

  function applyVoteCounts(counts: Record<string, number>) {
    for (const button of voteButtons) {
      const slug = button.dataset.vote ?? '';
      const countElement = button.querySelector<HTMLElement>('[data-vote-count]');
      if (countElement) countElement.textContent = String(counts[slug] ?? 0);
      if (voted.has(slug)) {
        button.disabled = true;
        const label = button.querySelector('span');
        if (label) label.textContent = 'Voted';
      }
    }
  }

  candidateSearch?.addEventListener('input', filterCandidates);
  candidateCategory?.addEventListener('change', filterCandidates);
  filterCandidates();

  fetch('/api/votes', { headers: { Accept: 'application/json' } })
    .then((response) => response.ok ? response.json() : Promise.reject())
    .then((data) => applyVoteCounts(data.counts ?? {}))
    .catch(() => { if (voteStatus) voteStatus.textContent = 'Vote totals are temporarily unavailable.'; });

  for (const button of voteButtons) button.addEventListener('click', async () => {
    const slug = button.dataset.vote;
    if (!slug || voted.has(slug)) return;
    button.disabled = true;
    try {
      const response = await fetch(`/api/votes/${encodeURIComponent(slug)}`, { method: 'POST', headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('vote failed');
      const data = await response.json();
      voted.add(slug);
      localStorage.setItem('sharedpair-votes', JSON.stringify([...voted]));
      const label = button.querySelector('span');
      const countElement = button.querySelector<HTMLElement>('[data-vote-count]');
      if (label) label.textContent = 'Voted';
      if (countElement) countElement.textContent = String(data.count);
      if (voteStatus) voteStatus.textContent = 'Vote recorded. Thank you.';
    } catch {
      button.disabled = false;
      if (voteStatus) voteStatus.textContent = 'The vote could not be recorded. Please try again.';
    }
  });
</script>

<style>
  .page-hero { min-height: 44vh; display: grid; grid-template-columns: 1.35fr .65fr; gap: 4vw; align-items: center; padding-block: 3.5rem; border-bottom: 1px solid var(--line); }
  .page-hero h1 { margin-bottom: 1rem; font-size: clamp(3rem, 5.5vw, 5.8rem); }
  em { color: var(--lime); font-style: normal; }
  [hidden] { display: none !important; }
  .filters { padding-block: 2rem; border-bottom: 1px solid var(--line); }
  .filter-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.25rem; }
  .filter-heading h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 3rem); }
  .filter-heading > p { margin: 0; color: var(--faint); font: .65rem var(--mono); text-transform: uppercase; }
  form { display: grid; grid-template-columns: minmax(190px, 1.35fr) repeat(4, minmax(130px, 1fr)) auto; gap: .7rem; align-items: end; }
  label span { display: block; margin-bottom: .4rem; color: var(--faint); font: .59rem var(--mono); letter-spacing: .07em; text-transform: uppercase; }
  input, select, form button, .empty button { width: 100%; min-height: 44px; border: 1px solid var(--line-strong); border-radius: 0; background: var(--surface); color: var(--ink); padding: 0 .75rem; font: .7rem var(--mono); }
  select { cursor: pointer; }
  form button, .empty button { width: auto; cursor: pointer; color: var(--muted); text-transform: uppercase; }
  form button:hover, .empty button:hover { border-color: var(--lime); color: var(--ink); }
  .records { padding-block: 3rem; border-bottom: 1px solid var(--line); }
  .records.blocked { padding-top: 0; }
  .runtime-heading { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: end; margin-bottom: 1.5rem; }
  .runtime-heading h2 { margin: 0; font-size: clamp(2.4rem, 4vw, 4rem); }
  .runtime-heading > div:last-child { padding-bottom: .35rem; text-align: right; font-family: var(--mono); }
  .runtime-heading strong, .runtime-heading small { display: block; }
  .runtime-heading strong { font-size: .8rem; }
  .runtime-heading small { margin-top: .3rem; color: var(--faint); font-size: .63rem; text-transform: uppercase; }
  .record { display: grid; grid-template-columns: 58px 1fr 210px 24px; gap: 1rem; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .record.has-image { grid-template-columns: 58px 150px 1fr 210px 24px; }
  .record > img { width: 150px; height: 82px; object-fit: cover; object-position: center; border: 1px solid var(--line); background: var(--surface); }
  .record > span, .record small { color: var(--faint); font: .68rem/1.7 var(--mono); }
  .record h3, .record p { margin: 0; }
  .record h3 { font-size: clamp(1.4rem, 2.5vw, 2.3rem); }
  .record p { color: var(--muted); }
  .record small b { color: var(--lime); font-weight: 500; }
  .record:hover h3 { color: var(--lime); }
  .empty { padding-block: 4rem; text-align: center; }
  .empty h2 { font-size: clamp(2rem, 4vw, 4rem); }
  .candidates { padding-block: 3rem; border-bottom: 1px solid var(--line); }
  .candidate-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; }
  .candidate-heading h2 { margin-bottom: 0; }
  .candidate-heading > p { margin: 0; color: var(--muted); }
  .candidate-controls { display: grid; grid-template-columns: 1fr 260px auto; gap: .8rem; align-items: end; margin-top: 2rem; }
  .candidate-controls > p { margin: 0 0 .8rem; color: var(--faint); font: .64rem var(--mono); text-transform: uppercase; }
  .voting-note { max-width: 900px; margin: 1.2rem 0 2rem; color: var(--faint); font-size: .86rem; }
  .candidate-groups > section { margin-top: 2.5rem; }
  .candidate-groups h3 { margin-bottom: .8rem; color: var(--violet); font: .72rem var(--mono); letter-spacing: .1em; text-transform: uppercase; }
  .candidate-table-wrap { overflow-x: auto; border: 1px solid var(--line); }
  .candidate table { width: 100%; }
  .candidate-groups table { width: 100%; border-collapse: collapse; background: var(--bg); }
  .candidate-groups th, .candidate-groups td { padding: .85rem .75rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; font: .66rem/1.5 var(--mono); }
  .candidate-groups th { color: var(--faint); text-transform: uppercase; white-space: nowrap; }
  .candidate-groups td:first-child { min-width: 260px; }
  .candidate-groups td:nth-child(2) { min-width: 190px; }
  .candidate-groups td strong, .candidate-groups td small { display: block; }
  .candidate-groups td strong { color: var(--ink); font: 600 1rem var(--sans); }
  .candidate-groups td small { max-width: 420px; margin-top: .25rem; color: var(--muted); font: .78rem/1.45 var(--sans); }
  .candidate-groups td a { color: var(--muted); }
  .candidate-groups button { display: inline-flex; align-items: center; gap: .6rem; min-height: 38px; padding: 0 .75rem; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); cursor: pointer; font: .65rem var(--mono); text-transform: uppercase; }
  .candidate-groups button:hover:not(:disabled) { border-color: var(--lime); }
  .candidate-groups button:disabled { cursor: default; color: var(--lime); }
  .candidate-groups button b { min-width: 1.5rem; color: var(--lime); }
  .candidate-empty, .vote-status { margin-top: 1.5rem; color: var(--muted); }
  @media (max-width: 1040px) { form { grid-template-columns: repeat(3, 1fr); } .search { grid-column: span 2; } }
  @media (max-width: 760px) { .page-hero { min-height: auto; grid-template-columns: 1fr; padding-block: 4rem; } .page-hero :global(svg) { order: -1; width: 70%; margin: auto; } .filter-heading { display: block; } .filter-heading > p { margin-top: 1rem; } form { grid-template-columns: 1fr 1fr; } .search { grid-column: 1 / -1; } .runtime-heading { grid-template-columns: 1fr; gap: .5rem; } .runtime-heading > div:last-child { text-align: left; } .record, .record.has-image, .record:not(.has-image) { grid-template-columns: 42px 1fr 20px; align-items: start; } .record > span:first-child { grid-column: 1; grid-row: 1 / span 2; padding-top: .3rem; } .record > img { grid-column: 2; width: min(180px, 100%); height: 88px; margin-bottom: .4rem; } .record > div { grid-column: 2; } .record > b:last-child { grid-column: 3; grid-row: 1 / span 2; align-self: center; } .record small { display: none; } .candidate-heading, .candidate-controls { grid-template-columns: 1fr; gap: 1rem; } }
  @media (max-width: 480px) { form { grid-template-columns: 1fr; } .search { grid-column: auto; } }
</style>
