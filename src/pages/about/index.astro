---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MotionLogo from '../../components/MotionLogo.astro';
import { sections } from '../../data/project';
const about = sections.about;
---
<BaseLayout title="About — Shared Pair" description={about.intro}>
  <header class="about-hero shell"><div class="about-logo"><MotionLogo size={512} eager /><strong>SHARED PAIR</strong><small>2c–2e</small></div><div><p class="eyebrow">About</p><h1>{about.title}</h1><p class="lede">{about.intro}</p></div></header>
  <section class="principles shell">{about.blocks.map(([title, detail]) => <article><h2>{title}</h2><p>{detail}</p></article>)}</section>
  <section class="contacts shell"><a href="mailto:packages@sharedpair.dev"><span>Contact</span><strong>packages@sharedpair.dev</strong></a><a href="https://apt.sharedpair.dev/"><span>APT repository</span><strong>apt.sharedpair.dev ↗</strong></a><a href="/"><span>Project</span><strong>Return to the one-page guide →</strong></a></section>
</BaseLayout>
<style>.about-hero{display:grid;grid-template-columns:280px 1fr;gap:5vw;align-items:center;padding-block:5rem}.about-logo{min-height:220px;display:grid;place-content:center;justify-items:center;gap:1rem}.about-logo :global(.motion-logo){width:190px;height:auto}.about-logo strong{font:700 .85rem var(--mono);letter-spacing:.18em}.about-logo small{color:var(--faint);font:.65rem var(--mono)}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.5rem,4vw,4rem);padding-block:3rem}.principles article{padding-top:.9rem}.principles article::before{content:'';display:block;width:2.5rem;height:2px;margin-bottom:1.2rem;background:linear-gradient(90deg,var(--lime),var(--violet))}.principles h2{font-size:1.5rem}.principles p{color:var(--muted)}.contacts{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.5rem,4vw,4rem);padding-block:3rem}.contacts a{padding:1rem 0;text-decoration:none}.contacts a:hover strong{color:var(--lime)}.contacts span,.contacts strong{display:block}.contacts span{color:var(--faint);font:.62rem var(--mono);text-transform:uppercase}.contacts strong{margin-top:.4rem;font:.75rem var(--mono)}@media(max-width:760px){.about-hero,.principles,.contacts{grid-template-columns:1fr}.about-logo{min-height:170px}.about-logo :global(.motion-logo){width:150px}}</style>
