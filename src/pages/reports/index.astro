---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BondMark from '../../components/BondMark.astro';
import { reports } from '../../data/project';
---

<BaseLayout title="Reports — Shared Pair" description="Cross-project architecture, build, and security reports for Shared Pair.">
  <header class="page-hero shell">
    <div><p class="eyebrow">Reports</p><h1>Show the work.</h1><p class="lede">These reports cover decisions and obligations shared across applications or runtime lines. Package-specific compatibility and test evidence stays with each application.</p></div>
    <BondMark compact />
  </header>
  <section class="records shell">
    {reports.map((report) => <a class="record" href={`/reports/${report.slug}/`}><span>{report.index}</span><div><p class="kind">{report.state}</p><h2>{report.title}</h2><p>{report.detail}</p></div><small>Updated<br />{report.updated}</small><b>→</b></a>)}
  </section>
</BaseLayout>

<style>
  .page-hero { min-height: 42vh; display: grid; grid-template-columns: 1.35fr .65fr; gap: 4vw; align-items: center; padding-block: 3.5rem; border-bottom: 1px solid var(--line); }
  .page-hero h1 { margin-bottom: 1rem; font-size: clamp(3rem, 5.5vw, 5.8rem); }
  .records { padding-block: 3rem; }
  .record { display: grid; grid-template-columns: 64px 1fr 140px 24px; gap: 1rem; align-items: center; padding: 1.35rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .record > span, .record small, .kind { color: var(--faint); font: .65rem/1.6 var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .record h2 { margin: .2rem 0 .35rem; font-size: clamp(1.7rem, 3vw, 2.7rem); }
  .record div > p:last-child { margin: 0; color: var(--muted); }
  .record:hover h2 { color: var(--lime); }
  @media (max-width: 760px) { .page-hero { min-height: auto; grid-template-columns: 1fr; padding-block: 4rem; } .page-hero :global(svg) { order: -1; width: 70%; margin: auto; } .record { grid-template-columns: 52px 1fr 20px; } .record small { display: none; } }
</style>
