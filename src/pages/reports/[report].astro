---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reports, type ReportRecord } from '../../data/project';

export function getStaticPaths() {
  return reports.map((record) => ({ params: { report: record.slug }, props: { record } }));
}

const { record } = Astro.props as { record: ReportRecord };
---

<BaseLayout title={`${record.title} — Shared Pair report`} description={record.detail}>
  <header class="report-hero shell">
    <div><a class="back" href="/reports/">← Reports</a><p class="eyebrow">{record.index} · {record.state}</p><h1>{record.title}</h1><p class="lede">{record.detail}</p></div>
    <dl><div><dt>Review state</dt><dd>Draft for approval</dd></div><div><dt>Updated</dt><dd>{record.updated}</dd></div><div><dt>Scope</dt><dd>Cross-project</dd></div></dl>
  </header>
  <section class="conclusion shell"><p class="eyebrow">Conclusion</p><p>{record.conclusion}</p></section>
  <section class="body shell">
    {record.sections.map((section, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.points && <ul>{section.points.map((point) => <li>{point}</li>)}</ul>}</div></article>)}
  </section>
  <nav class="report-nav shell" aria-label="Other reports">{reports.filter((report) => report.slug !== record.slug).map((report) => <a href={`/reports/${report.slug}/`}><span>{report.index}</span>{report.title} →</a>)}</nav>
</BaseLayout>

<style>
  .report-hero { min-height: 44vh; display: grid; grid-template-columns: 1fr 260px; gap: 5vw; align-items: center; padding-block: 3.5rem; border-bottom: 1px solid var(--line); }
  .report-hero h1 { max-width: 900px; margin-bottom: 1rem; font-size: clamp(3rem, 5.5vw, 5.8rem); }
  .back { display: inline-block; margin-bottom: 2rem; color: var(--muted); font: .68rem var(--mono); text-decoration: none; text-transform: uppercase; }
  .report-hero dl { margin: 0; padding: 1.1rem; border: 1px solid var(--line-strong); background: var(--surface); }
  .report-hero dl div { padding: .8rem 0; border-bottom: 1px solid var(--line); }
  .report-hero dl div:last-child { border: 0; }
  dt { color: var(--faint); font: .61rem var(--mono); text-transform: uppercase; }
  dd { margin: .35rem 0 0; font: .75rem var(--mono); }
  .conclusion { display: grid; grid-template-columns: 160px 1fr; gap: 2rem; padding-block: 2rem; border-bottom: 1px solid var(--line); }
  .conclusion > p:last-child { max-width: 850px; margin: 0; font-size: clamp(1.2rem, 2.5vw, 1.8rem); }
  .body { padding-block: 2rem; }
  article { display: grid; grid-template-columns: 160px 1fr; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  article > span { color: var(--violet); font: .68rem var(--mono); }
  article h2 { font-size: clamp(1.8rem, 3vw, 3rem); }
  article p, article ul { max-width: 780px; color: var(--muted); }
  article li { margin-bottom: .7rem; }
  .report-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-block: 2.5rem; }
  .report-nav a { padding: 1.4rem; border: 1px solid var(--line); text-decoration: none; }
  .report-nav span { display: block; margin-bottom: .5rem; color: var(--violet); font: .65rem var(--mono); }
  .report-nav a:hover { color: var(--lime); }
  @media (max-width: 760px) { .report-hero, .conclusion, article, .report-nav { grid-template-columns: 1fr; } .report-hero { min-height: auto; padding-block: 4rem; } }
</style>
