---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApplicationsSection from '../components/ApplicationsSection.astro';
import InstallSection from '../components/InstallSection.astro';
import RuntimesSection from '../components/RuntimesSection.astro';
import SecuritySection from '../components/SecuritySection.astro';
import MotionLogo from '../components/MotionLogo.astro';
---

<BaseLayout title="Shared Pair — Electron, shared" description="Shared, versioned Electron runtimes and compatible desktop applications for Linux.">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Shared Electron runtimes for Linux</p>
      <h1>Your apps.<br /><em>One runtime.</em></h1>
      <p class="lede">Shared Pair separates compatible desktop applications from the versioned Electron runtime they have in common—and keeps the packages, tests, provenance, and security updates together.</p>
      <div class="actions"><a class="button primary" href="#install">Install packages</a><a class="button" href="https://apt.sharedpair.dev/">Open APT repository ↗</a></div>
      <p class="disclaimer">Packages built, tested, signed, and publicly installable</p>
    </div>
    <div class="hero-logo" aria-label="Shared Pair logo"><MotionLogo size={512} eager /></div>
  </section>

  <InstallSection />
  <ApplicationsSection />
  <RuntimesSection />
  <SecuritySection />
</BaseLayout>

<style>
  em { color: var(--lime); font-style: normal; }
  .hero { min-height: calc(100vh - 72px); display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .75fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding-block: 6rem; }
  .hero-copy { max-width: 780px; }
  .hero-logo { display: grid; place-items: center; }
  .hero-logo :global(.motion-logo) { width: min(100%, 440px); height: auto; filter: drop-shadow(0 0 34px rgba(185,255,102,.16)) drop-shadow(0 0 48px rgba(165,139,255,.13)); }
  .hero h1 { margin-bottom: 2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .disclaimer { margin-top: 1rem; color: var(--faint); font: .65rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .trust { border-block: 1px solid var(--line); background: rgba(255,255,255,.018); }
  .trust-grid { display: grid; grid-template-columns: repeat(5, 1fr); }
  .trust-grid a { padding: 1.2rem; border-right: 1px solid var(--line); text-decoration: none; }
  .trust-grid a:first-child { border-left: 1px solid var(--line); }
  .trust-grid a:hover strong { color: var(--lime); }
  .trust span { display: block; color: var(--faint); font: .61rem var(--mono); text-transform: uppercase; letter-spacing: .11em; }
  .trust strong { display: block; margin-top: .4rem; font: 600 .76rem var(--mono); }
  .section { padding-block: clamp(5rem, 10vw, 9rem); border-bottom: 1px solid var(--line); }
  .section-head h2 { margin-bottom: 0; }
  .section-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 380px); gap: 3rem; align-items: end; margin-bottom: 3.2rem; }
  .section-head > p { margin: 0; color: var(--muted); }
  .bar-chart { display: grid; gap: 1.4rem; padding: 2rem 0; }
  .bar-row { display: grid; grid-template-columns: 130px 1fr 120px; gap: 1rem; align-items: center; font: .7rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .bar { height: 52px; background: var(--surface-2); border: 1px solid var(--line); }
  .bar i { display: block; height: 100%; background: linear-gradient(90deg, rgba(165,139,255,.28), rgba(165,139,255,.6)); border-right: 1px solid rgba(165,139,255,.55); }
  .bar.shared i { background: linear-gradient(90deg, rgba(185,255,102,.25), rgba(185,255,102,.65)); border-color: rgba(185,255,102,.6); }
  .chart-note { color: var(--faint); font: .62rem var(--mono); text-transform: uppercase; text-align: right; }
  @media (max-width: 880px) {
    .hero { min-height: auto; grid-template-columns: 1fr; padding-block: 5rem 2rem; }
    .hero-logo { grid-row: 1; }
    .hero-logo :global(.motion-logo) { width: min(68vw, 320px); }
    .trust-grid { grid-template-columns: 1fr 1fr; }
    .trust-grid a { border-bottom: 1px solid var(--line); }
    .section-head { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero h1 { font-size: 3.6rem; }
    .bar-row { grid-template-columns: 1fr; }
    .bar { height: 42px; }
  }
</style>
