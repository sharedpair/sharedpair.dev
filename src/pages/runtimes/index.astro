---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { applications, runtimes, sizeAccounting } from '../../data/project';
---

<BaseLayout title="Runtimes — Shared Pair" description="Shared Pair Electron runtime versions, package sizes, bounds, and compatible applications.">
  <header class="page-hero shell"><div><p class="eyebrow">Runtimes</p><h1>Two lines.<br /><em>Explicit bounds.</em></h1><p class="lede">Applications depend on the Electron major they passed against. Both runtime packages install side by side.</p></div><div class="total"><span>Compressed package set</span><strong>{sizeAccounting.sharedArchiveMiB} MiB</strong><small>{sizeAccounting.archiveSavedMiB} MiB below the per-app runtime model</small></div></header>
  {runtimes.map((runtime) => {
    const apps = applications.filter((app) => app.electron === runtime.version);
    return <section class="runtime shell"><header><div><p class="eyebrow">Electron runtime</p><h2>{runtime.version}</h2></div><dl><div><dt>Package</dt><dd>{runtime.packageName}</dd></div><div><dt>Archive</dt><dd>{runtime.archiveMiB} MiB</dd></div><div><dt>Installed</dt><dd>{runtime.installedMiB} MiB</dd></div><div><dt>Bounds</dt><dd>≥ {runtime.lower} · &lt; {runtime.upper}</dd></div></dl></header><div class="matrix"><div class="matrix-head"><span>Application</span><span>Package version</span><span>Archive</span><span>Test</span></div>{apps.map((app) => <a href={`/applications/${app.slug}/`}><strong>{app.name}</strong><span>{app.version}</span><span>{app.archiveMiB} MiB</span><span class="pass">Passed</span></a>)}</div></section>;
  })}
  <section class="method shell"><p class="eyebrow">Accounting note</p><p>The {sizeAccounting.bundledModelArchiveMiB} MiB comparison is not a sum of upstream installers. It uses the actual split application archives and adds one actual runtime archive per application. Shared Pair uses the same app archives with one runtime per represented line.</p></section>
</BaseLayout>

<style>
  em { color: var(--lime); font-style: normal; }
  .page-hero { min-height: 44vh; display: grid; grid-template-columns: 1fr 310px; gap: 5vw; align-items: center; padding-block: 3.5rem; border-bottom: 1px solid var(--line); }
  .page-hero h1 { margin-bottom: 1rem; font-size: clamp(3rem, 5.5vw, 5.8rem); }
  .total { padding: 1.4rem; border: 1px solid var(--line-strong); background: var(--surface); }
  .total span, .total small { display: block; color: var(--faint); font: .64rem/1.5 var(--mono); text-transform: uppercase; }
  .total strong { display: block; margin: .7rem 0; color: var(--lime); font-size: 2rem; }
  .runtime { padding-block: 3rem; border-bottom: 1px solid var(--line); }
  .runtime > header { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: end; margin-bottom: 2rem; }
  .runtime h2 { margin: 0; color: var(--lime); font-size: clamp(3rem, 6vw, 6rem); }
  dl { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; }
  dl div { padding: .8rem; border-left: 1px solid var(--line); }
  dt, .matrix-head { color: var(--faint); font: .61rem var(--mono); text-transform: uppercase; }
  dd { margin: .35rem 0 0; font: .73rem var(--mono); }
  .matrix { border-top: 1px solid var(--line); }
  .matrix-head, .matrix a { display: grid; grid-template-columns: 1.4fr 1fr 100px 80px; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .matrix a { font: .75rem var(--mono); }
  .matrix a:hover strong { color: var(--lime); }
  .pass { color: var(--lime); text-transform: uppercase; }
  .method { display: grid; grid-template-columns: 160px 1fr; gap: 2rem; padding-block: 2.5rem; }
  .method p:last-child { max-width: 820px; color: var(--muted); }
  @media (max-width: 760px) { .page-hero, .runtime > header, .method { grid-template-columns: 1fr; } dl { grid-template-columns: 1fr 1fr; } .matrix-head, .matrix a { grid-template-columns: 1fr 1fr; } .matrix-head span:nth-child(n+3), .matrix a span:nth-child(n+3) { display: none; } }
</style>
