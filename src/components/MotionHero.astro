<script>
  const stage = document.querySelector<HTMLElement>('#motion-stage');
  if (stage) {
    const observer = new IntersectionObserver(([entry]) => stage.toggleAttribute('data-offscreen', !entry.isIntersecting), { rootMargin: '120px' });
    observer.observe(stage);
    stage.addEventListener('pointermove', (event) => {
      const box = stage.getBoundingClientRect();
      stage.style.setProperty('--pointer-x', `${((event.clientX - box.left) / box.width - .5) * 36}px`);
      stage.style.setProperty('--pointer-y', `${((event.clientY - box.top) / box.height - .5) * 24}px`);
    });
  }
</script>

<style>
  .motion-stage { --pointer-x: 0px; --pointer-y: 0px; position: absolute; z-index: 0; top: 1rem; right: max(1.2rem, calc((100vw - 1180px)/2)); width: min(46vw, 620px); height: min(30vw, 340px); pointer-events: none; opacity: .9; }
  svg { width: 100%; height: 100%; overflow: visible; }
  .scene { display: none; transform-origin: center; }
  :global(html[data-motion-hero='H1']) .h1, :global(html[data-motion-hero='H2']) .h2, :global(html[data-motion-hero='H3']) .h3, :global(html[data-motion-hero='H4']) .h4, :global(html[data-motion-hero='H5']) .h5, :global(html[data-motion-hero='H6']) .h6, :global(html[data-motion-hero='H7']) .h7, :global(html[data-motion-hero='H8']) .h8, :global(html[data-motion-hero='H9']) .h9, :global(html[data-motion-hero='H10']) .h10 { display: block; }
  .field { filter: url(#motion-blur); } .f1 { fill: url(#motion-lime); } .f2 { fill: url(#motion-violet); }
  .node.lime, .hub.lime { fill: var(--lime); } .node.violet, .hub.violet { fill: var(--violet); }
  .electron, .satellites circle, .pipeline circle { fill: var(--ink); filter: drop-shadow(0 0 7px rgba(238,241,231,.8)); }
  .flow, .orbit, .bond, .rail { fill: none; stroke: rgba(238,241,231,.3); stroke-width: 2; stroke-dasharray: 7 9; }
  rect, .signed { fill: rgba(17,19,25,.72); stroke: rgba(238,241,231,.28); stroke-width: 1.5; }
  text { fill: rgba(238,241,231,.72); font: 12px var(--mono); text-anchor: middle; letter-spacing: .08em; }
  .lime-stroke { stroke: var(--lime); } .violet-stroke { stroke: var(--violet); }
  .check { fill: none; stroke: var(--lime); stroke-width: 5; }
  .seal { fill: rgba(185,255,102,.2); stroke: var(--lime); stroke-width: 2; }

  .h1 .f1 { animation: field-left 5s ease-in-out infinite; } .h1 .f2 { animation: field-right 5s ease-in-out infinite; }
  .h2 .flow, .h7 .flow, .h9 .flow { animation: flow 1.4s linear infinite; }
  .h2 .pipeline > * { animation: pipeline 3.6s ease-in-out infinite backwards; } .h2 .pipeline > :nth-child(2) { animation-delay: .5s; } .h2 .pipeline > :nth-child(3) { animation-delay: 1s; }
  .h3 .orbit { animation: orbit-dash 8s linear infinite; } .h3 .satellites { transform-origin: 310px 170px; animation: constellation 10s linear infinite; }
  .h4 .mono { animation: mono-fade 4s ease-in-out infinite; } .h4 .split { animation: split 4s ease-in-out infinite; }
  .h5 .duplicates rect { animation: collapse 4s ease-in-out infinite; transform-box: fill-box; transform-origin: center; } .h5 .shared-core { animation: core-pulse 4s ease-in-out infinite; }
  .h6 .e1 { animation: electron-a 3s linear infinite; } .h6 .e2 { animation: electron-b 3s linear infinite; }
  .h7 .chambers > * { animation: chamber-pass 4s ease-in-out infinite; } .h7 .check { stroke-dasharray: 65; animation: draw-check 4s ease-in-out infinite; }
  .h8 .rail { animation: flow 1.6s linear infinite; } .h8 .rail-cars { animation: rail-cars 5s ease-in-out infinite; }
  .h9 .evidence text { animation: evidence 4s ease-in-out infinite; } .h9 .seal { animation: seal 2s ease-in-out infinite; }
  .h10 .interactive-left { transform: translate(var(--pointer-x), var(--pointer-y)); } .h10 .interactive-right { transform: translate(calc(var(--pointer-x) * -1), calc(var(--pointer-y) * -1)); } .h10 .interactive-field { transform: translateX(calc(var(--pointer-x) * .25)); }
  :global(html[data-motion-debug='true']) .motion-stage { outline: 1px dashed var(--violet); background: rgba(165,139,255,.04); }
  :global(html[data-motion-debug='true']) .motion-label::after { content: attr(data-code); }
  :global(html[data-motion-enabled='false']) .motion-stage { display: none; }
  :global(html[data-motion-paused='true']) .motion-stage *, .motion-stage[data-offscreen] * { animation-play-state: paused !important; }

  @keyframes field-left { 50% { transform: translateX(55px) scale(1.08); } } @keyframes field-right { 50% { transform: translateX(-55px) scale(1.08); } }
  @keyframes flow { to { stroke-dashoffset: -32; } } @keyframes pipeline { 0%,20% { opacity:.2; transform:translateY(8px) } 45%,85% { opacity:1; transform:none } 100% { opacity:.2 } }
  @keyframes orbit-dash { to { stroke-dashoffset:-120; } } @keyframes constellation { to { transform:rotate(360deg); } }
  @keyframes mono-fade { 0%,20%{opacity:1} 55%,100%{opacity:.08;transform:scale(.7)} } @keyframes split { 0%,20%{opacity:0;transform:scale(.7)} 55%,100%{opacity:1;transform:none} }
  @keyframes collapse { 50% { transform:translateX(110px) scale(.5);opacity:.2 } } @keyframes core-pulse { 50% { filter:drop-shadow(0 0 24px var(--lime)); } }
  @keyframes electron-a { 25%{transform:translate(50px,25px)}50%{transform:translate(0,50px)}75%{transform:translate(-50px,25px)} } @keyframes electron-b { 25%{transform:translate(-50px,-25px)}50%{transform:translate(0,-50px)}75%{transform:translate(50px,-25px)} }
  @keyframes chamber-pass { 0%,15%{opacity:.3}35%,80%{opacity:1}100%{opacity:.3} } @keyframes draw-check { 0%,50%{stroke-dashoffset:65}70%,90%{stroke-dashoffset:0}100%{opacity:0} }
  @keyframes rail-cars { 50% { transform:translateX(65px); } } @keyframes evidence { 0%,15%{opacity:.2}35%,80%{opacity:1}100%{opacity:.2} } @keyframes seal { 50%{transform:scale(1.12);transform-origin:center} }
  @media (max-width: 760px) { .motion-stage { position: relative; inset: auto; width: 100%; height: auto; margin: 0 auto -2rem; } }
</style>
