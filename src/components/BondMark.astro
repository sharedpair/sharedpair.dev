---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<svg class:list={['bond-mark', { compact }]} viewBox="0 0 520 280" role="img" aria-labelledby="bond-title bond-desc">
  <title id="bond-title">Two-centre, two-electron bond</title>
  <desc id="bond-desc">Two centres joined by an overlapping electron-density field containing two electrons with opposite spin projections.</desc>
  <defs>
    <radialGradient id="left-field">
      <stop offset="0" stop-color="#b9ff66" stop-opacity=".42" />
      <stop offset="1" stop-color="#b9ff66" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="right-field">
      <stop offset="0" stop-color="#a58bff" stop-opacity=".42" />
      <stop offset="1" stop-color="#a58bff" stop-opacity="0" />
    </radialGradient>
    <filter id="blur"><feGaussianBlur stdDeviation="18" /></filter>
  </defs>
  <ellipse cx="205" cy="140" rx="156" ry="104" fill="url(#left-field)" filter="url(#blur)" />
  <ellipse cx="315" cy="140" rx="156" ry="104" fill="url(#right-field)" filter="url(#blur)" />
  <circle cx="112" cy="140" r="17" class="centre left" />
  <circle cx="408" cy="140" r="17" class="centre right" />
  <path d="M130 140H390" class="axis" />
  <g class="electron one" transform="translate(239 119)">
    <circle r="8" />
    <path d="M0 20V-18m0 0-7 8m7-8 7 8" />
  </g>
  <g class="electron two" transform="translate(281 161)">
    <circle r="8" />
    <path d="M0-20V18m0 0-7-8m7 8 7-8" />
  </g>
  <text x="260" y="245" text-anchor="middle">2c–2e · paired spin</text>
</svg>

<style>
  .bond-mark { display: block; width: min(100%, 640px); height: auto; overflow: visible; }
  .centre { stroke-width: 2; }
  .centre.left { fill: #b9ff66; stroke: #e5ffc7; }
  .centre.right { fill: #a58bff; stroke: #ded6ff; }
  .axis { stroke: rgba(236, 240, 226, .25); stroke-width: 1; stroke-dasharray: 4 8; }
  .electron circle { fill: #f3f5ed; filter: drop-shadow(0 0 10px rgba(243,245,237,.8)); }
  .electron path { fill: none; stroke: #f3f5ed; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  text { fill: rgba(236,240,226,.56); font: 12px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .13em; text-transform: uppercase; }
  .compact text { display: none; }
</style>
