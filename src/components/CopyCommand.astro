---
interface Props { command?: string; displayCommand?: string; }
const { command, displayCommand } = Astro.props;
---

<div class="copy-command" data-command={command}>
  <pre><code>{displayCommand ?? command ?? <slot />}</code></pre>
  <button type="button" class="copy-command__button" aria-label="Copy command" title="Copy command">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="8" width="12" height="12" rx="2"></rect>
      <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
    </svg>
    <span>Copy</span>
  </button>
  <span class="copy-command__feedback" aria-hidden="true">Copied</span>
  <span class="copy-command__status" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.copy-command').forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>('.copy-command__button');
    const code = block.querySelector<HTMLElement>('code');
    const label = button?.querySelector('span');
    const feedback = block.querySelector<HTMLElement>('.copy-command__feedback');
    const status = block.querySelector<HTMLElement>('.copy-command__status');

    button?.addEventListener('click', async () => {
      if (!code || !label || !feedback || !status) return;

      try {
        await navigator.clipboard.writeText(block.dataset.command ?? code.textContent ?? '');
        label.textContent = 'Copied';
        button.setAttribute('aria-label', 'Command copied');
        status.textContent = 'Command copied to clipboard.';
        feedback.classList.remove('is-visible');
        void feedback.offsetWidth;
        feedback.classList.add('is-visible');
        window.setTimeout(() => {
          label.textContent = 'Copy';
          button.setAttribute('aria-label', 'Copy command');
          status.textContent = '';
          feedback.classList.remove('is-visible');
        }, 1800);
      } catch {
        label.textContent = 'Select';
        button.setAttribute('aria-label', 'Select command to copy');
        status.textContent = 'Clipboard unavailable. Select the command text to copy it.';
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(code);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });
  });
</script>

<style>
  .copy-command { position: relative; }
  pre { overflow-wrap: anywhere; white-space: pre-wrap; margin: 0; padding: .8rem 3.4rem .8rem .9rem; border: 1px solid var(--line); background: var(--surface); color: var(--lime); font: .72rem/1.55 var(--mono); }
  .copy-command__button { position: absolute; top: .55rem; right: .55rem; display: inline-flex; width: 34px; min-height: 34px; padding: 0; align-items: center; justify-content: center; border: 1px solid var(--line-strong); background: rgba(23,26,33,.94); color: var(--muted); cursor: pointer; }
  .copy-command__button:hover { border-color: var(--lime); color: var(--ink); }
  .copy-command__button:active { transform: translateY(1px); }
  .copy-command__feedback { position: absolute; z-index: 2; top: .55rem; right: .55rem; transform: translateY(-.25rem); padding: .3rem .48rem; border: 1px solid var(--lime); background: var(--lime); color: #10130d; opacity: 0; pointer-events: none; font: 700 .58rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .copy-command__feedback.is-visible { animation: copy-feedback 1.35s ease-out both; }
  .copy-command__button span, .copy-command__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @keyframes copy-feedback {
    0% { opacity: 0; transform: translateY(-.25rem); }
    15% { opacity: 1; }
    70% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-2.35rem); }
  }
  @media (max-width: 560px) {
    pre { padding-right: 3.4rem; }
  }
</style>
