---
import { applications, reports, runtimes, sizeAccounting } from '../data/project';
---
<section class="one-section shell" id="runtimes" aria-labelledby="runtimes-heading">
  <header class="section-heading"><div><p class="eyebrow">Runtimes</p><h2 id="runtimes-heading">Two lines.<br /><em>Explicit bounds.</em></h2></div><p>Applications depend on the Electron major they passed against. Both runtime packages install side by side.</p></header>
  {runtimes.map((runtime) => { const apps = applications.filter((app) => app.electron === runtime.version); return <article class="runtime"><header><h3>Electron {runtime.version}</h3><dl><div><dt>Package</dt><dd>{runtime.packageName}</dd></div><div><dt>Archive</dt><dd>{runtime.archiveMiB} MiB</dd></div><div><dt>Installed</dt><dd>{runtime.installedMiB} MiB</dd></div><div><dt>Bounds</dt><dd>≥ {runtime.lower} · &lt; {runtime.upper}</dd></div></dl></header><div class="matrix">{apps.map((app) => <a href={`#applications-${app.slug}`}><strong>{app.name}</strong><span>{app.version}</span><span>{app.archiveMiB} MiB</span><b>Passed</b></a>)}</div></article>; })}
  <p class="accounting">The measured shared package set is {sizeAccounting.sharedArchiveMiB} MiB—{sizeAccounting.archiveSavedMiB} MiB below the modeled per-application runtime case.</p>
  <div class="notes"><p class="eyebrow">Runtime decisions and obligations</p>{reports.map((report) => <details id={`runtime-${report.slug}`}><summary><span>{report.index}</span><div><small>{report.state}</small><h3>{report.title}</h3><p>{report.conclusion}</p></div><b class="toggle" aria-hidden="true"></b></summary><div class="note-body">{report.sections.map((section) => <section><h4>{section.title}</h4>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.points && <ul>{section.points.map((point) => <li>{point}</li>)}</ul>}</section>)}</div></details>)}</div>
</section>
<style>
  em { color:var(--lime);font-style:normal}.one-section{padding-block:4rem;border-bottom:1px solid var(--line)}.section-heading{display:grid;grid-template-columns:1fr minmax(260px,420px);gap:3rem;align-items:end}.section-heading h2{margin:0}.section-heading>p{margin:0;color:var(--muted)}.runtime{padding:2.5rem 0;border-bottom:1px solid var(--line)}.runtime>header{display:grid;grid-template-columns:1fr 2fr;gap:2rem;align-items:end}.runtime h3{margin:0;color:var(--lime);font-size:clamp(2rem,4vw,4rem)}dl{display:grid;grid-template-columns:repeat(4,1fr);margin:0}dl div{padding:.8rem;border-left:1px solid var(--line)}dt{color:var(--faint);font:.6rem var(--mono);text-transform:uppercase}dd{margin:.3rem 0 0;font:.7rem var(--mono)}.matrix{margin-top:1.4rem;border-top:1px solid var(--line)}.matrix a{display:grid;grid-template-columns:1.4fr 1fr 100px 80px;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--line);font:.72rem var(--mono);text-decoration:none}.matrix a:hover strong{color:var(--lime)}.matrix b{color:var(--lime);text-transform:uppercase}.accounting{max-width:850px;margin:2rem 0;color:var(--muted)}.notes{margin-top:3rem;border-top:1px solid var(--line)}.notes>.eyebrow{margin-top:2rem}.notes details{border-bottom:1px solid var(--line)}summary{display:grid;grid-template-columns:64px 1fr auto;gap:1rem;padding:1.4rem .75rem;cursor:pointer;list-style:none;transition:background .15s}summary::-webkit-details-marker{display:none}summary:hover,summary:focus-visible{background:var(--surface)}summary>span,summary small{color:var(--faint);font:.63rem var(--mono);text-transform:uppercase}summary h3{margin:.2rem 0;font-size:clamp(1.4rem,2.5vw,2.3rem)}summary p{max-width:850px;margin:0;color:var(--muted)}.toggle{display:grid;place-items:center;align-self:center;width:42px;height:42px;border:1px solid var(--lime);border-radius:50%}.toggle::before{content:'';width:10px;height:10px;border-right:2px solid var(--lime);border-bottom:2px solid var(--lime);transform:translateY(-2px) rotate(45deg);transition:transform .18s ease}details[open]>summary .toggle::before{transform:translateY(2px) rotate(225deg)}details[open]>.note-body{animation:reveal-details .18s ease-out both}@keyframes reveal-details{from{opacity:0;transform:translateY(-6px)}}.note-body{margin-left:80px;padding-bottom:2rem}.note-body section{max-width:820px;padding:1rem 0}.note-body p,.note-body li{color:var(--muted)}
  @media(max-width:760px){.section-heading,.runtime>header{grid-template-columns:1fr}dl{grid-template-columns:1fr 1fr}.matrix a{grid-template-columns:1fr 1fr}.matrix span:nth-child(3),.matrix b{display:none}.note-body{margin-left:0}}
</style>
