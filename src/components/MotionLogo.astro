---
interface Props { size?: number; eager?: boolean; }
const { size = 64, eager = false } = Astro.props;
const source = size > 192 ? '/images/brand/logo-512.png' : size > 64 ? '/images/brand/logo-192.png' : '/images/brand/logo-64.png';
---
<img class="motion-logo" src={source} width={size} height={size} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} decoding="async" />

<style>
  .motion-logo { display: block; width: 38px; height: 38px; object-fit: contain; flex: 0 0 auto; }
</style>
